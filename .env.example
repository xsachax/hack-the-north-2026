# Server-side only. Never prefix credentials with NEXT_PUBLIC_.
BROWSERBASE_API_KEY=
# Optional: Stagehand can resolve your default project.
BROWSERBASE_PROJECT_ID=
# Comma-separated exact HTTPS media origins explicitly verified/approved by the operator.
# Empty deliberately disables embedded replay; never copy an arbitrary playlist URL here.
BROWSERBASE_REPLAY_ORIGINS=
STAGEHAND_MODEL=google/gemini-2.5-flash
# Product ceiling: 8 concurrent Browserbase agents across all workers; default stays 3.
# New runs select at most 8 personas. This is not permission to run a hosted proof.
MAX_CONCURRENT_SESSIONS=3
MAX_STEPS_PER_PERSONA=12
SESSION_TIMEOUT_SECONDS=120
DATA_DIR=./data
# Offline API; no Browserbase key needed. Production requires an exact HTTPS origin
# and a random access code of at least 32 characters, provisioned outside git.
APP_ORIGIN=http://127.0.0.1:3000
FLASH_FLOOD_ACCESS_CODE=
# Explicit paid demo/registered-site admission; requires a strong access code even in development.
ENABLE_DEMO_RUNS=false
# Explicit public read-only admission; remains off by default.
# Requires a strong access code, SESSION_TIMEOUT_SECONDS > 80, and per-session native attestation.
ENABLE_PUBLIC_RUNS=false
FIXTURE_PORT=4321
# Must not exceed the shared product ceiling of 8; lower owner limits still apply.
MAX_OWNER_SESSIONS=3
MAX_MODEL_CALLS_PER_PERSONA=14
DEVELOPMENT_BUDGET_SECONDS=324000
EXTERNAL_BASELINE_SECONDS=363
OWNER_BUDGET_SECONDS=3600
LIFETIME_RESERVATION_LIMIT_SECONDS=324000
WORKER_LEASE_MS=30000
WORKER_RECOVERY_LIMIT=6
WORKER_SHUTDOWN_MS=60000
