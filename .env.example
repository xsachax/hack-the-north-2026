# Server-side only. Never prefix credentials with NEXT_PUBLIC_.
BROWSERBASE_API_KEY=
# Optional: Stagehand can resolve your default project.
BROWSERBASE_PROJECT_ID=
STAGEHAND_MODEL=google/gemini-2.5-flash
MAX_CONCURRENT_SESSIONS=3
MAX_STEPS_PER_PERSONA=12
SESSION_TIMEOUT_SECONDS=120
DATA_DIR=./data
# Offline API; no Browserbase key needed. Production requires an exact HTTPS origin
# and a random access code of at least 32 characters, provisioned outside git.
APP_ORIGIN=http://127.0.0.1:3000
FLASH_FLOOD_ACCESS_CODE=
