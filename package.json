{
  "name": "flash-flood",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:http": "tsx scripts/api-smoke.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test",
    "browserbase:smoke": "tsx scripts/browserbase-smoke.ts",
    "persona:integration": "tsx scripts/persona-integration.ts",
    "worker": "tsx scripts/worker.ts",
    "worker:reconcile": "tsx scripts/worker-reconcile.ts",
    "worker:integration": "tsx scripts/worker-integration.ts",
    "controlled:integration": "tsx scripts/controlled-integration.ts"
  },
  "dependencies": {
    "@browserbasehq/sdk": "2.20.0",
    "@browserbasehq/stagehand": "4.1.0",
    "@next/env": "16.3.5",
    "next": "16.3.5",
    "playwright-core": "1.58.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
