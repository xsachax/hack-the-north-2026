APP_ORIGIN=https://flood.example.com
ENABLE_DEMO_RUNS=false
ENABLE_PUBLIC_RUNS=false
ENABLE_MANAGED_AGENTS=false
BROWSERBASE_MANAGED_AGENT_ID=
MANAGED_AGENT_ALLOWED_ORIGINS=
# An execution flag plus runtime credentials and this confirmation are required.
DEPLOYMENT_CONFIRM_PAID=false
# Containers listen on all container interfaces; clean local rehearsals use 127.0.0.1.
DEPLOYMENT_BIND_HOST=0.0.0.0
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REPLAY_ORIGINS=
STAGEHAND_MODEL=google/gemini-2.5-flash
MAX_CONCURRENT_SESSIONS=3
MAX_OWNER_SESSIONS=3
MAX_STEPS_PER_PERSONA=12
MAX_MODEL_CALLS_PER_PERSONA=14
SESSION_TIMEOUT_SECONDS=120
DEVELOPMENT_BUDGET_SECONDS=324000
# Conservative known project history, not a replacement for actual prior usage.
EXTERNAL_BASELINE_SECONDS=1092
OWNER_BUDGET_SECONDS=3600
LIFETIME_RESERVATION_LIMIT_SECONDS=3600
WORKER_LEASE_MS=30000
WORKER_RECOVERY_LIMIT=6
WORKER_SHUTDOWN_MS=60000
